    "Shows cues only while you're traveling at vehicle speed, and hides them again shortly after you stop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Hinweise nur, während du mit Fahrzeuggeschwindigkeit unterwegs bist, und blendet sie kurz nach dem Anhalten wieder aus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra os indicadores apenas enquanto você se desloca em velocidade de veículo e os oculta pouco depois que você para."
          }
        }
      }
    },
